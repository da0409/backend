{
  "name": "houlai-ne",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "test:rest": "node scripts/test-rest.mjs",
    "test:e2e": "playwright test",
    "dev:mock": "vite --config vite.config.ts --mode mock",
