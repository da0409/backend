  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.17.30",
    "@vitejs/plugin-vue": "^5.2.3",
    "esbuild": "^0.28.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.8"
  }
}
